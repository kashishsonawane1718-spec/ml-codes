
import pandas as pd
import seaborn as sns

from sklearn.impute import SimpleImputer
from sklearn.preprocessing import LabelEncoder, StandardScaler

# Step 1: Load the dataset
df = pd.read_csv('titanic.csv')

print("Original Dataset:")
print(df.head())

# Step 2: Display missing values
print("\nMissing Values Before Handling:")
print(df.isnull().sum())

# Step 3: Select relevant columns and create a copy
df = df[['Survived', 'Pclass', 'Name', 'Sex', 'Age',
         'SibSp', 'Fare', 'Embarked']].copy()

# Step 4: Convert Age and Fare into numeric format
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
df['Fare'] = pd.to_numeric(df['Fare'], errors='coerce')

# Step 5: Handle missing numerical values using mean
num_imputer = SimpleImputer(strategy='mean')

df[['Age', 'Fare']] = num_imputer.fit_transform(
    df[['Age', 'Fare']]
)

# Step 6: Handle missing categorical values
cat_imputer = SimpleImputer(strategy='most_frequent')

df[['Embarked']] = cat_imputer.fit_transform(
    df[['Embarked']]
)

print("\nMissing Values After Handling:")
print(df.isnull().sum())

# Step 7: Encode categorical variables
label_encoder = LabelEncoder()

df['Sex'] = label_encoder.fit_transform(df['Sex'])
df['Embarked'] = label_encoder.fit_transform(df['Embarked'])

# Step 8: Remove Name column
df = df.drop('Name', axis=1)

# Step 9: Scale numerical attributes
scaler = StandardScaler()

numerical_columns = ['Age', 'Fare', 'SibSp']

df[numerical_columns] = scaler.fit_transform(
    df[numerical_columns]
)

# Step 10: Display cleaned dataset
print("\nModel Ready Dataset:")
print(df.tail())

# Step 11: Display dataset information
print("\nDataset Information:")
df.info()

# Step 12: Save processed dataset
df.to_csv("titanic_cleaned.csv", index=False)

print("\nFeature engineering completed successfully.")
print("Processed dataset saved as 'titanic_cleaned.csv'")
